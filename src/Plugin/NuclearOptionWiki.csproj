<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>NuclearOptionWiki</AssemblyName>
    <RootNamespace>NuclearOptionWiki</RootNamespace>
    <Version>0.5.0</Version>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>embedded</DebugType>
    <LibDir>$(MSBuildThisFileDirectory)..\..\lib\</LibDir>
  </PropertyGroup>

  <!-- Le code « Core » (sans Unity) est compilé dans la DLL du mod et testé à part (tests/Core.Tests). -->
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- weapons.json et aircraft.json intégrés à la DLL : le mod fonctionne avec ce seul fichier (import NOMM). Un weapons.json posé à côté reste prioritaire. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\weapons.json" LogicalName="NuclearOptionWiki.weapons.json" />
    <EmbeddedResource Include="..\..\data\aircraft.json" LogicalName="NuclearOptionWiki.aircraft.json" />
  </ItemGroup>

  <!-- Références fournies par le jeu et BepInEx : déposées dans lib/ (ignoré par git), jamais copiées dans la sortie. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(LibDir)BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LibDir)0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(LibDir)Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(LibDir)Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(LibDir)UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(LibDir)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(LibDir)UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(LibDir)UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(LibDir)UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(LibDir)UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(LibDir)UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(LibDir)Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
