<Project Sdk="Microsoft.NET.Sdk">

  <!-- Exécute WikiConfig avec le vrai ConfigFile de BepInEx (nécessite lib/). Lancement : dotnet run, projet tests/Config.Smoke. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>MSB3277</NoWarn>
    <LibDir>$(MSBuildThisFileDirectory)..\..\lib\</LibDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Plugin\WikiConfig.cs" Link="WikiConfig.cs" />
    <Reference Include="BepInEx"><HintPath>$(LibDir)BepInEx.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(LibDir)UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(LibDir)UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>

</Project>
